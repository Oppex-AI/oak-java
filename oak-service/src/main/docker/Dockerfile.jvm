# oak-service (Quarkus fast-jar) — the customer-side runbook executor. Build context = the oak-java repo
# root, so the module path is included:
#   docker build -f oak-service/src/main/docker/Dockerfile.jvm -t oak-service .
#
# Runtime config is env-driven (OAK_PLATFORM_BASE_URL, OAK_UI_PORT, ...) but the platform base URL and
# API key are normally set from the management page and persisted under OAK_DATA_DIR — mount a volume
# there so they survive restarts. The service listens only for its own status UI.
FROM registry.access.redhat.com/ubi9/openjdk-21:1.23

# Built-in-capability CLIs, pinned (runtime contract — see README). OAK's tools shell out to the
# `aws` and `docker` clients (ProcessBuilder, no SDK), so the image must ship them. Installed to
# /usr/bin so they are on PATH for the non-root service user. Uses the docker *static* tarball (not a
# distro-linked binary) so it runs on ubi9's glibc. The trailing --version calls fail the build loudly
# if either install breaks. Bump the versions intentionally.
ARG AWS_CLI_VERSION=2.37.3
ARG DOCKER_CLI_VERSION=27.3.1
USER root
RUN microdnf install -y unzip tar gzip && microdnf clean all \
 && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip" -o /tmp/awscliv2.zip \
 && unzip -q /tmp/awscliv2.zip -d /tmp \
 && /tmp/aws/install --bin-dir /usr/bin --install-dir /usr/local/aws-cli \
 && rm -rf /tmp/aws /tmp/awscliv2.zip \
 && curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
    | tar xz --strip-components=1 -C /usr/bin docker/docker \
 && aws --version && docker --version
USER 185
WORKDIR /deployments
COPY oak-service/target/quarkus-app/ ./

# Default management-UI port (override with OAK_UI_PORT). Persisted settings live in OAK_DATA_DIR.
EXPOSE 9020
ENTRYPOINT ["java", "-Djava.util.logging.manager=org.jboss.logmanager", "-jar", "quarkus-run.jar"]
